# Puerto en el que escucha Node (en el 205 se abre http://IP-DEL-205:4173)
PORT=4173

# MySQL. En el 205, si Node y MySQL están en la misma máquina, deja 127.0.0.1.
# DB_PASSWORD debe ser la misma que pusiste en sql/crear-planner-mysql.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=planner
DB_PASSWORD=Planner2026!
DB_NAME=colbeef_planner

# Secreto para las sesiones. Cámbialo en el servidor por una frase larga.
JWT_SECRET=cambia-esta-frase-larga-en-el-205
JWT_EXPIRES_IN=8h

# Clave con la que nacen los usuarios y a la que el director puede restablecer.
# Cada persona la cambia al entrar, con el botón de la llave.
INITIAL_PASSWORD=Cambiar2026!
STANDARD_PASSWORD=Cambiar2026!

# Super admin TIC. Si tic@colbeef.com no existe, el servidor la crea con esta clave.
TIC_PASSWORD=cambia-esta-clave
